# Copy this file to .env and fill in your own values. Never commit .env.
MONGO_URI=mongodb://localhost:27017/hydroforest
# A long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=
PORT=5005

# Optional
# Frontend addresses allowed to call the API, comma-separated.
# CORS_ORIGINS=http://localhost:3000
# Login and signup attempts allowed per IP every 15 minutes.
# AUTH_RATE_LIMIT=20
